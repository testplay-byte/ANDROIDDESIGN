<resources>
    <!-- Base theme — the actual visual theme is applied via Compose (AppTheme).
         This XML theme just sets the window background + transparent bars to match
         the Primary Glass palette so there's no white flash on launch. -->
    <style name="Theme.AgentTech" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
