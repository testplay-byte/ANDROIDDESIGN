<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: "AT" monogram in cool light grey on transparent.
     The background is the blue color (ic_launcher_background). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.5"
        android:scaleY="0.5"
        android:translateX="27"
        android:translateY="27">
        <!-- "A" — left diagonal + right diagonal + crossbar -->
        <path
            android:fillColor="#F5F5F5"
            android:pathData="M54,28 L34,80 L44,80 L54,54 L64,80 L74,80 Z" />
        <!-- Crossbar of A -->
        <path
            android:fillColor="#F5F5F5"
            android:pathData="M45,68 L63,68 L63,74 L45,74 Z" />
        <!-- "T" — vertical + horizontal -->
        <path
            android:fillColor="#F5F5F5"
            android:pathData="M70,42 L88,42 L88,50 L80,50 L80,80 L70,80 L70,50 L62,50 L62,42 Z" />
    </group>
</vector>
